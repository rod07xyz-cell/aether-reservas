    {
      "id": "a97a66c8-07da-4b7d-aa14-75bf26ae1ddb",
      "name": "Preparar agenda",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Convierte las filas al formato del panel. Las reservas «anuladas» (duplicadas) no se muestran.\nconst hoy = DateTime.now().setZone('Europe/Madrid').toISODate();\nconst reservas = $('Reservas del rango').all().map(function (it) { return it.json; })\n  .filter(function (r) { return r.id && r.estado !== 'anulada'; })\n  .map(function (r) {\n    return { id: r.id, paciente: r.nombre, telefono: r.telefono || '', email: r.email || '', servicio: r.servicio, inicio: r.inicio,\n      hueco: r.hueco, estado: r.estado, origen: r.origen, notas: r.notas || '', creada: r.createdAt, cancelada_en: r.cancelada_en };\n  });\nconst espera = $('Lista de espera activa').all().map(function (it) { return it.json; })\n  .filter(function (e) { return e.id && e.dia >= hoy; })\n  .map(function (e) {\n    return { id: e.id, nombre: e.nombre, dia: e.dia, franja: e.franja, servicio: e.servicio, estado: e.estado,\n      hueco_ofrecido: e.hueco_ofrecido || '', oferta_caduca_en: e.oferta_caduca_en };\n  });\nreturn [{ json: { ok: true, reservas: reservas, espera: espera } }];"
      }
    },
