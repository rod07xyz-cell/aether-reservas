    {
      "id": "432d9b25-bfa2-486b-836f-a84652a7c470",
      "name": "Validar acción",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        360
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b = $input.first().json.body || {};\nconst id = Number(b.id);\nconst accion = String(b.accion || '');\nconst ESTADO = { asistio: 'asistio', no_asistio: 'no_asistio', reabrir: 'confirmada' };\nlet ruta = 'error';\nif (Number.isInteger(id) && id > 0) {\n  if (accion === 'cancelar') ruta = 'cancelar';\n  else if (accion === 'notas') ruta = 'notas';\n  else if (ESTADO[accion]) ruta = 'estado';\n}\nreturn [{ json: { ruta: ruta, id: id, accion: accion, estado: ESTADO[accion] || '', notas: String(b.notas || '').replace(/[<>]/g, '').trim().slice(0, 300) } }];"
      }
    },
    {
      "id": "ec9fe0f9-0b83-4076-824a-cd27bd560e63",
      "name": "Según la acción",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        480,
        360
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "outputKey": "estado",
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.ruta }}",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "rightValue": "estado"
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "outputKey": "notas",
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.ruta }}",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "rightValue": "notas"
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "outputKey": "cancelar",
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.ruta }}",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "rightValue": "cancelar"
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "outputKey": "error",
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.ruta }}",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "rightValue": "error"
                  }
                ],
                "combinator": "and"
              }
            }
          ]
        }
      }
