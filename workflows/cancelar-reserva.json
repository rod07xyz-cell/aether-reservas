            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $json.id }}"
            },
            {
              "keyName": "estado",
              "condition": "eq",
              "keyValue": "confirmada"
            }
          ]
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "estado": "cancelada",
            "cancelada_en": "={{ $now.toUTC().toISO() }}",
            "notas": "={{ $json.quien === \"clinica\" ? \"Cancelada desde el panel\" : \"Cancelada por el paciente\" }}"
          },
          "matchingColumns": [],
          "schema": [
            {
              "id": "estado",
              "displayName": "estado",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "cancelada_en",
              "displayName": "cancelada_en",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "dateTime",
              "canBeUsedToMatch": true
            },
            {
              "id": "notas",
              "displayName": "notas",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            }
          ]
        }
      }
    },
