    {
      "id": "cb87a0da-8b5e-4048-8f86-15b093328387",
      "name": "Comprobar si se puede cancelar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const r = $input.first().json;\nconst quien = $('Al cancelar una reserva').first().json.quien === 'clinica' ? 'clinica' : 'paciente';\nconst ini = r.hueco ? DateTime.fromISO(r.hueco, { zone: 'Europe/Madrid' }) : null;\nlet motivo = '';\nif (!r.id) motivo = 'no_encontrada';\nelse if (r.estado !== 'confirmada') motivo = 'ya_cancelada';\nelse if (!ini || !ini.isValid || ini < DateTime.now()) motivo = 'pasada';\nreturn [{ json: {\n  puede: !motivo,\n  motivo: motivo,\n  quien: quien,\n  id: r.id || 0,\n  hueco: r.hueco || '',\n  nombre: r.nombre || '',\n  email: r.email || '',\n  servicio: r.servicio || '',\n  gcal_event_id: r.gcal_event_id || '',\n  fecha_texto: ini && ini.isValid ? ini.setLocale('es').toFormat(\"cccc d 'de' LLLL 'a las' HH:mm\") : ''\n} }];"
      }
    },
    {
      "id": "e321c5a9-d63e-40ab-9b65-60ecaf6edc86",
      "name": "¿Se puede cancelar?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.puede }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "rightValue": ""
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "26282adb-2b5f-4267-b08c-24f595af09dd",
