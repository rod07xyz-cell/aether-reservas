              "condition": "eq",
              "keyValue": "={{ $('Calcular plazo').item.json.dia }}"
            },
            {
              "keyName": "estado",
              "condition": "eq",
              "keyValue": "esperando"
            }
          ]
        },
        "returnAll": true,
