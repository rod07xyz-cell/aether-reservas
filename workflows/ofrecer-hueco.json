    },
    {
      "id": "359d20b9-6a0e-4574-9e0d-4c1a23ad9263",
      "name": "Elegir siguiente de la lista",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Por orden de alta (ID más bajo), solo quien aceptó esa franja y no ha descartado ya este hueco.\nconst p = $('Calcular plazo').first().json;\nconst reservado = !!$('¿Ya está reservado?').first().json.id;\nconst ofrecido = !!$('¿Ya está ofrecido?').first().json.id;\nlet elegido = null;\nif (!reservado && !ofrecido) {\n  const filas = $('Lista de espera de ese día').all().map(function (it) { return it.json; }).filter(function (f) { return f.id; });\n  filas.sort(function (a, b) { return a.id - b.id; });\n  for (let i = 0; i < filas.length; i++) {\n    const f = filas[i];\n    const descartados = String(f.huecos_descartados || '').split(',');\n    if ((f.franja === 'cualquiera' || f.franja === p.franja) && descartados.indexOf(p.hueco) < 0) { elegido = f; break; }\n  }\n}\nreturn [{ json: {\n  hay: !!elegido,\n  motivo: reservado ? 'ya_reservado' : (ofrecido ? 'ya_ofrecido' : (elegido ? '' : 'nadie_en_lista')),\n  espera_id: elegido ? elegido.id : 0,\n  nombre: elegido ? elegido.nombre : '',\n  email: elegido ? elegido.email : '',\n  servicio: elegido ? elegido.servicio : '',\n  hueco: p.hueco,\n  caduca: p.caduca,\n  caduca_texto: p.caduca_texto,\n  fecha_texto: p.fecha_texto\n} }];"
      }
    },
