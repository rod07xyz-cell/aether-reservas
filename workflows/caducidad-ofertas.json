            {
              "keyName": "estado",
              "condition": "eq",
              "keyValue": "ofrecido"
            }
          ]
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "estado": "esperando",
            "token_oferta": "",
            "hueco_ofrecido": "",
