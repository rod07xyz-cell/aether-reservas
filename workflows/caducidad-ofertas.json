              "type": "string",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "canBeUsedToMatch": true
            }
          ]
        }
      }
    },
    {
      "id": "f61b78a4-3e50-466a-af1d-d9c027c72008",
      "name": "Ofrecer al siguiente",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        720,
        200
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "CONFIGURAR_ID_WORKFLOW_OFRECER_HUECO",
          "cachedResultName": "Fisio Movimiento · Ofrecer hueco a la lista de espera (subworkflow)"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "hueco": "={{ $('Ofertas caducadas').item.json.hueco_ofrecido }}"
          },
          "matchingColumns": [],
          "schema": [
            {
              "id": "hueco",
              "displayName": "hueco",
              "type": "string",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "canBeUsedToMatch": true
            }
          ]
        },
        "mode": "each",
        "options": {
          "waitForSubWorkflow": true
        }
      }
    },
    {
