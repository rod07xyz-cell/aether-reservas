{
  "name": "Fisio Movimiento · Caducidad de ofertas de la lista de espera",
  "nodes": [
    {
      "id": "8f170d4b-90f7-439c-a764-0af9d4a2059e",
      "name": "Cada 10 minutos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 10
            }
          ]
        }
      }
    },
    {
      "id": "7df94073-f33f-4129-88bc-f0b3e19a0d1a",
      "name": "Ofertas caducadas",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        240,
        200
      ],
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "CONFIGURAR_ID_TABLA_LISTA_ESPERA",
          "cachedResultName": "lista_espera"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "estado",
              "condition": "eq",
              "keyValue": "ofrecido"
            },
            {
              "keyName": "oferta_caduca_en",
              "condition": "lt",
              "keyValue": "={{ $now.toUTC().toISO() }}"
            }
          ]
        },
        "returnAll": true
      }
    },
    {
      "id": "183251b0-d0e3-4f12-a616-7c01d80448e9",
      "name": "Devolver a la lista",
