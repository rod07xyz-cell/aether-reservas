    {
      "id": "f4319a5a-5655-4a0c-bc5b-1716d3afab28",
      "name": "Calcular huecos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1140,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// CONFIGURACIÓN DEL HORARIO (igual que en «Crear reserva»).\nconst H = {\n  zona: 'Europe/Madrid',\n  dias: [1, 2, 3, 4, 5],\n  horas: ['09:00', '10:00', '11:00', '12:00', '13:00', '16:00', '17:00', '18:00', '19:00'],\n  antelacionMinHoras: 2,\n  diasVista: 30,\n  festivos: []\n};\nconst ocupados = {};\n$('Reservas confirmadas próximas').all().forEach(function (it) { if (it.json.hueco) ocupados[it.json.hueco] = true; });\nconst ahora = DateTime.now().setZone(H.zona);\n$('Huecos ofrecidos a la lista').all().forEach(function (it) {\n  const caduca = it.json.oferta_caduca_en ? DateTime.fromISO(String(it.json.oferta_caduca_en)) : null;\n  if (it.json.hueco_ofrecido && caduca && caduca > ahora) ocupados[it.json.hueco_ofrecido] = true;\n});\nconst minimo = ahora.plus({ hours: H.antelacionMinHoras });\nconst dias = [];\nfor (let i = 0; i <= H.diasVista; i++) {\n  const d = ahora.startOf('day').plus({ days: i });\n  if (H.dias.indexOf(d.weekday) < 0 || H.festivos.indexOf(d.toISODate()) >= 0) continue;\n  const huecos = H.horas.map(function (h) {\n    const clave = d.toISODate() + 'T' + h;\n    const ini = DateTime.fromISO(clave, { zone: H.zona });\n    return { hueco: clave, hora: h, libre: ini >= minimo && !ocupados[clave] };\n  });\n  dias.push({ fecha: d.toISODate(), libres: huecos.filter(function (x) { return x.libre; }).length, huecos: huecos });\n}\nreturn [{ json: { ok: true, generado: ahora.toISO(), dias: dias } }];"
      }
    },
