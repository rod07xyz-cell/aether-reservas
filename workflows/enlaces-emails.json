    {
      "id": "8c71ba80-3a87-4af0-b906-4e591e618ef8",
      "name": "Decidir qué hacer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Abrir el enlace solo hace «ver_…» (lectura). Cancelar, aceptar y rechazar llegan desde un botón de la página.\nconst ZONA = 'Europe/Madrid';\nconst v = $('Validar enlace').first().json;\nconst r = $('Reserva de ese enlace').first().json;\nconst o = $('Oferta de ese enlace').first().json;\nconst ahora = DateTime.now();\nconst texto = function (h) { const d = DateTime.fromISO(String(h || ''), { zone: ZONA }); return d.isValid ? d.setLocale('es').toFormat(\"cccc d 'de' LLLL 'a las' HH:mm\") : ''; };\nconst pila = function (n) { return String(n || '').split(' ')[0]; };\nconst salida = { ruta: 'responder', codigo: 200, respuesta: {}, accion: v.accion, seguir: v.seguir };\nconst fallo = function (codigo, error, mensaje) { salida.codigo = codigo; salida.respuesta = { ok: false, error: error, message: mensaje }; };\n\nif (v.tipo === 'reserva') {\n  if (!r.id) fallo(404, 'not_found', 'Este enlace no es válido.');\n  else {\n    const futura = DateTime.fromISO(r.hueco, { zone: ZONA }) > ahora;\n    const cancelable = r.estado === 'confirmada' && futura;\n    if (v.accion === 'ver_reserva') {\n      salida.respuesta = { ok: true, tipo: 'reserva', estado: r.estado, fecha_texto: texto(r.hueco), hueco: r.hueco, servicio: r.servicio, nombre: pila(r.nombre), cancelable: cancelable };\n    } else if (!cancelable) {\n      fallo(409, r.estado === 'confirmada' ? 'pasada' : 'ya_cancelada', r.estado === 'confirmada' ? 'Esta cita ya ha pasado.' : 'Esta cita ya estaba cancelada.');\n    } else {\n      salida.ruta = 'cancelar';\n      salida.reserva_id = r.id;\n    }\n  }\n} else {\n  if (!o.id) fallo(404, 'not_found', 'Este enlace ya se ha usado o no es válido.');\n  else {\n    const caduca = o.oferta_caduca_en ? DateTime.fromISO(String(o.oferta_caduca_en)) : null;\n    const vigente = o.estado === 'ofrecido' && caduca && caduca > ahora;\n    const desc = String(o.huecos_descartados || '').split(',').filter(function (x) { return x; });\n    if (desc.indexOf(o.hueco_ofrecido) < 0) desc.push(o.hueco_ofrecido);\n    salida.espera_id = o.id;\n    salida.hueco = o.hueco_ofrecido;\n    salida.servicio = o.servicio;\n    salida.nombre = o.nombre;\n    salida.email = o.email;\n    salida.telefono = o.telefono || '';\n    salida.descartados = desc.join(',');\n    salida.fecha_texto = texto(o.hueco_ofrecido);\n    if (v.accion === 'ver_oferta') {\n      salida.respuesta = { ok: true, tipo: 'oferta', vigente: !!vigente, estado: o.estado, fecha_texto: texto(o.hueco_ofrecido), hueco: o.hueco_ofrecido, servicio: o.servicio, nombre: pila(o.nombre), caduca_en: caduca ? caduca.toISO() : '', caduca_texto: caduca ? caduca.setZone(ZONA).setLocale('es').toFormat('HH:mm') : '' };\n    } else if (v.accion === 'aceptar') {\n      if (!vigente) fallo(410, 'expired', 'El plazo para aceptar este hueco ha terminado.');\n      else salida.ruta = 'aceptar';\n    } else {\n      if (o.estado !== 'ofrecido') fallo(409, 'conflict', 'Esta oferta ya no está disponible.');\n      else salida.ruta = 'rechazar';\n    }\n  }\n}\nreturn [{ json: salida }];"
      }
    },
