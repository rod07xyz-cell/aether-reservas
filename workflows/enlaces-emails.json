    {
      "id": "c0893760-7a33-4672-bd71-48948aa4786c",
      "name": "Validar enlace",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b = $input.first().json.body || {};\nconst accion = String(b.accion || '').toLowerCase();\nconst token = String(b.token || '').trim().toLowerCase();\nconst ACCIONES = { ver_reserva: 'reserva', cancelar: 'reserva', ver_oferta: 'oferta', aceptar: 'oferta', rechazar: 'oferta' };\nconst valido = !!ACCIONES[accion] && /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/.test(token);\nreturn [{ json: { valido: valido, accion: accion, tipo: ACCIONES[accion] || '', token: valido ? token : '', seguir: b.seguir !== false && b.seguir !== 'false' } }];"
      }
    },
