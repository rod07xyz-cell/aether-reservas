# Valores que hay que configurar en cada instalación (no van en un .env real:
# se ponen en n8n, en comun/config.js y en panel/config.js). Aquí solo para tenerlos a mano.

# n8n
N8N_URL=https://n8n.tu-clinica.es
TABLA_RESERVAS_ID=CONFIGURAR_ID_TABLA_RESERVAS
TABLA_LISTA_ESPERA_ID=CONFIGURAR_ID_TABLA_LISTA_ESPERA

# Correo (credencial SMTP de n8n)
REMITENTE="Tu Clínica <hola@tu-clinica.es>"
EMAIL_AVISOS=hola@tu-clinica.es

# Google Calendar (credencial OAuth2 de n8n)
CALENDARIO_ID=CONFIGURAR_ID_CALENDARIO

# Panel de recepción (credencial Header Auth de n8n; cabecera X-Panel-Clave)
# Genera una clave larga y aleatoria y guárdala solo en n8n y en el gestor de contraseñas de la clínica.
PANEL_CLAVE=

# Páginas (comun/config.js, panel/config.js y nodo «Validar hueco»)
URL_PAGINAS=https://tu-clinica.es/reservas
ORIGENES_CORS=https://tu-clinica.es
